+// Patch 10 (draft): the two motion controllers, for the game program's hand IK.
+// Samples both controllers' GRIP poses at the same predicted time a head sample uses, in the same
+// space (OpenXR local: +X right, +Y up, -Z forward, metres). Each pose is 7 floats:
+// position x, y, z, then orientation x, y, z, w. A hand that is not tracked holds identity.
+// sample_id: a fresh number per call (0 = no sample); hand it to rex_xr_hands_aim for the aim poses
+// of the same call. flags: which parts are valid this frame (DK_XR_HAND_* below). Returns 1 when at
+// least one grip orientation is valid, 0 otherwise (also when the actions could not be set up).
+enum : uint32_t {
+  DK_XR_HAND_L_ORIENT = 0x01,   // left grip orientation valid
+  DK_XR_HAND_L_POS = 0x02,      // left grip position valid
+  DK_XR_HAND_L_TRACKED = 0x04,  // left grip orientation AND position tracked (not inferred)
+  DK_XR_HAND_R_ORIENT = 0x10,
+  DK_XR_HAND_R_POS = 0x20,
+  DK_XR_HAND_R_TRACKED = 0x40,
+  DK_XR_HAND_L_AIM = 0x100,     // left aim pose valid (orientation and position)
+  DK_XR_HAND_R_AIM = 0x200,
+  DK_XR_HAND_SYNCED = 0x80000000u,  // xrSyncActions succeeded this call (session focused)
+};
+extern "C" __declspec(dllexport) int rex_xr_sample_hands(uint32_t* sample_id, float grip_left[7],
+                                                         float grip_right[7], uint32_t* flags);
+// The aim poses (pointing ray: -Z forward) taken in the same rex_xr_sample_hands call. Returns 1
+// when sample_id is that call's id, 0 when it is stale or unknown (outputs then hold identity).
+extern "C" __declspec(dllexport) int rex_xr_hands_aim(uint32_t sample_id, float aim_left[7],
+                                                      float aim_right[7]);
