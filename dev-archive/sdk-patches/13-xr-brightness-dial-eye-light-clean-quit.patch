+// Patch 13: mean brightness of each eye's picture (the stored, gamma-encoded values, 0..1), every
+// 8th pixel each way, then the running numbers for the report. A gap between the eyes that keeps one
+// sign points at a per-eye fault; one that swaps sides points at lights the game animates per frame.
+void EyeBlit::ReadLight(uint32_t slot) {
+  double mean[2] = {};
+  for (int e = 0; e < 2; ++e) {
+    ID3D12Resource* b = light_buf_[slot][e].Get();
+    if (!b) return;
+    const D3D12_RANGE read = {0, SIZE_T(light_fp_[e].Footprint.RowPitch) * light_h_};
+    void* data = nullptr;
+    if (FAILED(b->Map(0, &read, &data)) || !data) return;
+    const uint8_t* base = static_cast<const uint8_t*>(data);
+    const bool ten = light_fmt_ == DXGI_FORMAT_R10G10B10A2_UNORM;
+    const bool bgr = light_fmt_ == DXGI_FORMAT_B8G8R8A8_UNORM;
+    double sum = 0;
+    uint32_t count = 0;
+    for (uint32_t y = 4; y < light_h_; y += 8) {
+      const uint32_t* row =
+          reinterpret_cast<const uint32_t*>(base + SIZE_T(y) * light_fp_[e].Footprint.RowPitch);
+      for (uint32_t x = 4; x < light_w_; x += 8) {
+        const uint32_t v = row[x];
+        float r, g, bl;
+        if (ten) {
+          r = float(v & 1023) / 1023.0f;
+          g = float((v >> 10) & 1023) / 1023.0f;
+          bl = float((v >> 20) & 1023) / 1023.0f;
+        } else {
+          r = float(v & 255) / 255.0f;
+          g = float((v >> 8) & 255) / 255.0f;
+          bl = float((v >> 16) & 255) / 255.0f;
+          if (bgr) std::swap(r, bl);
+        }
+        sum += 0.2126 * r + 0.7152 * g + 0.0722 * bl;
+        ++count;
+      }
+    }
+    const D3D12_RANGE none = {0, 0};
+    b->Unmap(0, &none);
+    mean[e] = count ? sum / count : 0.0;
+  }
+  LightStats& t = light_;
+  const double gap = mean[1] - mean[0];
+  const double mag = gap < 0 ? -gap : gap;
+  ++t.frames;
+  t.sum_l += mean[0];
+  t.sum_r += mean[1];
+  t.sum_gap += mag;
+  if (mag > t.max_gap) t.max_gap = mag;
+  if (mean[0] < t.min_l) t.min_l = mean[0];
+  if (mean[0] > t.max_l) t.max_l = mean[0];
+  constexpr double kGapCounts = 0.01;  // a 1 % brightness difference between the eyes
+  if (mag > kGapCounts) {
+    ++t.gap_frames;
+    const int sign = gap > 0 ? 1 : -1;
+    if (t.last_sign != 0 && sign != t.last_sign) ++t.swaps;
+    t.last_sign = sign;
+  }
+  if (t.frames >= kLightReportPairs) {
+    std::snprintf(light_line_, sizeof(light_line_),
+                  "[XR] eye light: %u pairs, mean L=%.3f R=%.3f, |R-L| mean=%.4f max=%.4f, "
+                  "over 1%%: %u pairs, side swaps %u, L range %.3f-%.3f, dial %.2f",
+                  t.frames, t.sum_l / t.frames, t.sum_r / t.frames, t.sum_gap / t.frames, t.max_gap,
+                  t.gap_frames, t.swaps, t.min_l, t.max_l, double(gamma_));
+    light_ready_ = true;
+    t = LightStats{};
+  }
+}
+
+bool EyeBlit::TakeLightReport(char* line, size_t size) {
+  if (!light_ready_) return false;
+  std::snprintf(line, size, "%s", light_line_);
+  light_ready_ = false;
+  return true;
+}
