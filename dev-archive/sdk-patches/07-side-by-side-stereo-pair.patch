+void D3D12CommandProcessor::ComposeSideBySidePair(ID3D12Resource* guest_output, uint32_t width,
+                                                  uint32_t height) {
+  // guest_output is 2W x H, in kGuestOutputInternalState, with this swap's image in [0, W).
+  // sbs_current_ / sbs_previous_ are W x H copies that rest in COPY_SOURCE between swaps.
+  constexpr D3D12_RESOURCE_STATES kOutputState = ui::d3d12::D3D12Presenter::kGuestOutputInternalState;
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+
+  auto retire = [this](Microsoft::WRL::ComPtr<ID3D12Resource>& r) {
+    if (r && submission_completed_ < submission_current_) {
+      r->AddRef();
+      resources_for_deletion_.emplace_back(submission_current_, r.Get());
+    }
+    r.Reset();
+  };
+  auto make = [&](Microsoft::WRL::ComPtr<ID3D12Resource>& r) -> bool {
+    D3D12_RESOURCE_DESC desc = {};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = width;
+    desc.Height = height;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = ui::d3d12::D3D12Presenter::kGuestOutputFormat;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+    return SUCCEEDED(device->CreateCommittedResource(
+        &ui::d3d12::util::kHeapPropertiesDefault, GetD3D12Provider().GetHeapFlagCreateNotZeroed(),
+        &desc, D3D12_RESOURCE_STATE_COPY_SOURCE, nullptr, IID_PPV_ARGS(&r)));
+  };
+  if (sbs_width_ != width || sbs_height_ != height) {
+    retire(sbs_current_);
+    retire(sbs_previous_);
+    sbs_have_previous_ = false;
+    sbs_width_ = width;
+    sbs_height_ = height;
+  }
+  if ((!sbs_current_ && !make(sbs_current_)) || (!sbs_previous_ && !make(sbs_previous_))) {
+    REXGPU_ERROR("[SBS] could not create the {}x{} pair textures; showing one eye", width, height);
+    return;
+  }
+
+  D3D12_TEXTURE_COPY_LOCATION out_loc = {guest_output, D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX};
+  D3D12_TEXTURE_COPY_LOCATION cur_loc = {sbs_current_.Get(),
+                                         D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX};
+  D3D12_TEXTURE_COPY_LOCATION prev_loc = {sbs_previous_.Get(),
+                                          D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX};
+  const D3D12_BOX half = {0, 0, 0, width, height, 1};
+
+  // 1. Save this swap's image.
+  PushTransitionBarrier(guest_output, kOutputState, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  PushTransitionBarrier(sbs_current_.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE,
+                        D3D12_RESOURCE_STATE_COPY_DEST);
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyTextureRegion(&cur_loc, 0, 0, 0, &out_loc, &half);
+
+  // 2. Lay out the pair: this swap on the side its parity names, the previous swap on the other.
+  //    Even swaps go left. Before any previous swap exists, both halves show this one.
+  const uint32_t side = uint32_t(sbs_swaps_ & 1u);
+  PushTransitionBarrier(sbs_current_.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+                        D3D12_RESOURCE_STATE_COPY_SOURCE);
+  PushTransitionBarrier(guest_output, D3D12_RESOURCE_STATE_COPY_SOURCE,
+                        D3D12_RESOURCE_STATE_COPY_DEST);
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyTextureRegion(&out_loc, side * width, 0, 0, &cur_loc, &half);
+  deferred_command_list_.D3DCopyTextureRegion(&out_loc, (1u - side) * width, 0, 0,
+                                              sbs_have_previous_ ? &prev_loc : &cur_loc, &half);
+  PushTransitionBarrier(guest_output, D3D12_RESOURCE_STATE_COPY_DEST, kOutputState);
+
+  if (sbs_swaps_ == 0) {
+    REXGPU_INFO("[SBS] side-by-side pair on: {}x{} per eye, even swaps on the LEFT", width, height);
+  }
+  sbs_current_.Swap(sbs_previous_);
+  sbs_have_previous_ = true;
+  ++sbs_swaps_;
+}
