 namespace rex::graphics::d3d12 {
 
 // Generated with `xb buildshaders`.
@@ -2292,6 +2302,42 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
     // Always need a vertex shader.
     return false;
   }
+
+  // Diagnostic: per-draw vertex constants c0..c7 (gpu_dump_draw_constants). Sampled here,
+  // after the shader is known and before any early return, because the game rewrites these
+  // constants for every object - by IssueSwap they only hold the last draw's values.
+  {
+    static int dump_state = 0;  // 0 = not yet checked, 1 = writing, -1 = off
+    static std::FILE* dump_file = nullptr;
+    static uint32_t dump_records = 0;
+    if (dump_state == 0) {
+      const std::string dump_path = REXCVAR_GET(gpu_dump_draw_constants);
+      if (!dump_path.empty()) {
+        dump_file = std::fopen(dump_path.c_str(), "wb");
+        if (!dump_file) {
+          REXGPU_ERROR("gpu_dump_draw_constants: cannot open {}", dump_path);
+        }
+      }
+      dump_state = dump_file ? 1 : -1;
+    }
+    if (dump_state == 1) {
+      const uint64_t epoch_ms = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                             std::chrono::system_clock::now().time_since_epoch())
+                                             .count());
+      const uint32_t frame = counter();
+      const uint32_t count = 8;
+      std::fwrite(&epoch_ms, sizeof(epoch_ms), 1, dump_file);
+      std::fwrite(&frame, sizeof(frame), 1, dump_file);
+      std::fwrite(&count, sizeof(count), 1, dump_file);
+      // Registers hold each float as its host-order IEEE-754 bit pattern, contiguous in values[].
+      std::fwrite(&regs[XE_GPU_REG_SHADER_CONSTANT_000_X], sizeof(uint32_t), 8 * 4, dump_file);
+      // Flush often: automated runs end by killing the process, which loses unflushed data.
+      if ((++dump_records & 1023) == 0) {
+        std::fflush(dump_file);
+      }
+    }
+  }
+
   pipeline_cache_->AnalyzeShaderUcode(*vertex_shader);
   bool memexport_used_vertex = vertex_shader->memexport_eM_written() != 0;
 
