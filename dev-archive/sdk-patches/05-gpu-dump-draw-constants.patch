+// Diagnostic, off by default (empty path). When set, every draw appends one record of vertex
+// shader float constants c0..c7 to this file, for identifying camera/view-projection constants.
+// Record, little-endian: u64 epoch_ms, u32 frame, u32 count(=8), then 8*4 f32. Sampled per DRAW
+// because constants are overwritten per object, so a frame-end snapshot shows only the last draw.
+REXCVAR_DEFINE_STRING(gpu_dump_draw_constants, "", "GPU/D3D12",
+                      "Diagnostic: append per-draw vertex constants c0..c7 to this file")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
