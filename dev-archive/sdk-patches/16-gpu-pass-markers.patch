+void D3D12CommandProcessor::DkPassMarkerUpdate(reg::RB_DEPTHCONTROL normalized_depth_control,
+                                               uint32_t normalized_color_mask) {
+  if (!debug_markers_enabled_) {
+    return;
+  }
+  const RegisterFile& regs = *register_file_;
+  auto rb_surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  auto rb_depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+  bool depth_used = normalized_depth_control.z_enable || normalized_depth_control.stencil_enable;
+  uint32_t key[6];
+  key[0] = uint32_t(rb_surface_info.surface_pitch) | (uint32_t(rb_surface_info.msaa_samples) << 16);
+  key[1] = depth_used ? (UINT32_C(0x80000000) | uint32_t(rb_depth_info.depth_base) |
+                         (uint32_t(rb_depth_info.depth_format) << 16))
+                      : 0;
+  char colors[160];
+  int colors_length = 0;
+  colors[0] = 0;
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    key[2 + i] = 0;
+    if (!(normalized_color_mask & (UINT32_C(0b1111) << (4 * i)))) {
+      continue;
+    }
+    auto color_info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+    key[2 + i] = UINT32_C(0x80000000) | uint32_t(color_info.color_base) |
+                 (uint32_t(color_info.color_format) << 16);
+    if (colors_length < int(sizeof(colors)) - 1) {
+      int written = std::snprintf(colors + colors_length, sizeof(colors) - size_t(colors_length),
+                                  " c%u %s@%u", i,
+                                  xenos::GetColorRenderTargetFormatName(color_info.color_format),
+                                  uint32_t(color_info.color_base));
+      if (written > 0) {
+        colors_length = std::min(colors_length + written, int(sizeof(colors)) - 1);
+      }
+    }
+  }
+  if (dk_pass_open_ && !std::memcmp(key, dk_pass_key_, sizeof(key))) {
+    return;
+  }
+  DkPassMarkerClose();
+  std::memcpy(dk_pass_key_, key, sizeof(key));
+  char depth[48];
+  if (depth_used) {
+    std::snprintf(depth, sizeof(depth), "%s@%u",
+                  xenos::GetDepthRenderTargetFormatName(rb_depth_info.depth_format),
+                  uint32_t(rb_depth_info.depth_base));
+  } else {
+    std::snprintf(depth, sizeof(depth), "off");
+  }
+  // "@N" is the surface's EDRAM base in tiles; the pitch is in guest pixels.
+  PushDebugMarker("DK pass %u | pitch %u msaa %ux | depth %s |%s | %s", dk_pass_index_++,
+                  uint32_t(rb_surface_info.surface_pitch),
+                  UINT32_C(1) << uint32_t(rb_surface_info.msaa_samples), depth,
+                  colors_length ? colors : " no colour",
+                  normalized_color_mask ? "colour writes on" : "DEPTH-ONLY");
+  dk_pass_open_ = true;
+}
